<%- include('partials/header', { pageTitle: 'Galeri' }) %>

  <div class="sayfa-basligi">
    <div class="container">
      <h1>Galeri</h1>
      <div class="cizgi"></div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Fotoğraflar</h2>
        <div class="cizgi"></div>
      </div>
      <% if (images.length) { %>
      <div class="galeri-grid">
        <% images.forEach(function (item, i) { %>
          <div class="galeri-item reveal gecikme-<%= i % 3 %>" data-buyuk="<%= item.file %>">
            <img src="<%= item.file %>" alt="<%= item.title || settings.siteTitle %>" loading="lazy">
            <% if (item.title) { %><div class="baslik"><%= item.title %></div><% } %>
          </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="galeri-bos">Henüz fotoğraf eklenmedi. Çok yakında kurumumuzdan kareler burada olacak!</div>
      <% } %>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-title">
        <h2>Videolar</h2>
        <div class="cizgi"></div>
      </div>
      <% if (videos.length) { %>
      <div class="galeri-grid">
        <% videos.forEach(function (item, i) { %>
          <div class="galeri-item reveal gecikme-<%= i % 3 %>" style="cursor:default;">
            <video src="<%= item.file %>" controls preload="metadata"></video>
            <% if (item.title) { %><div class="baslik" style="pointer-events:none;"><%= item.title %></div><% } %>
          </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="galeri-bos">Henüz video eklenmedi.</div>
      <% } %>
    </div>
  </section>

  <div class="lightbox" id="lightbox">
    <button class="kapat" aria-label="Kapat">&times;</button>
    <img src="" alt="Büyük görsel">
  </div>

<%- include('partials/footer') %>
